# Herald deployment environment.
# Copy to `.env` and fill in before `docker compose up -d`.
# NEVER commit a real `.env`.

# --- Image ---
# Published multi-arch image (linux/amd64 + arm64). Pin a version for reproducible
# deploys, e.g. ghcr.io/timzaak/herald:0.4.1. Set to a local tag to use a self-built image.
HERALD_IMAGE=ghcr.io/timzaak/herald:latest

# --- Admin bootstrap (read at runtime via env) ---
ADMIN_EMAIL=admin@example.com
# REQUIRED in production — app refuses to start without it.
# Generate: openssl rand -base64 24
ADMIN_PASSWORD=change-me-please
ADMIN_REALM_ID=admin

# --- Service secrets (read at runtime via env) ---
# Internal API key for /api/internal/* (X-Internal-Api-Key header).
# Generate: openssl rand -hex 24
INTERNAL_API_KEY=change-me-please
# TOTP HMAC key, MUST be >=32 bytes.
# Generate: openssl rand -base64 48
TOTP_SECRET_KEY=change-me-please-min-32-bytes-change-me-now
